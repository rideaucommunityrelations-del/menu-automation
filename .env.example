# Copy to .env for local development. On Render, set these in the service's
# Environment tab instead (the free plan has no persistent disk, so a
# committed/local .env never reaches the deployed container).

PORT=3000

# Gmail address to send from + a 16-character Gmail App Password
# (Google Account -> Security -> 2-Step Verification -> App Passwords).
# Requires 2-Step Verification enabled on the account.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Comma-separated list of recipient emails for the daily menu.
MENU_RECIPIENTS=
